{
  "name": "moonfleet",
  "private": true,
  "version": "0.1.0",
  "dependencies": {
    "@18ways/react": "^1.2.0",
    "ajv": "^8.20.0",
    "decap-cms-app": "3.1.11",
    "detect-port": "^2.1.0",
    "gatsby": "^5.16.1",
    "gatsby-plugin-decap-cms": "^4.0.4",
    "gatsby-plugin-netlify": "^5.1.1",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "glob": "^10.4.2",
    "markdown-to-jsx": "^7.4.7",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-image-gallery": "^1.3.0",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "prettier": "^2.0.5"
  },
  "keywords": [
    "gatsby"
  ],
  "engines": {
    "bun": ">=1.3.8",
    "node": "22.x"
  },
  "packageManager": "bun@1.3.8",
  "overrides": {
    "detect-port": "$detect-port"
  },
  "scripts": {
    "check:runtime": "node scripts/check-runtime.js",
    "prebuild": "bun run check:runtime",
    "build": "GATSBY_TELEMETRY_DISABLED=1 XDG_CONFIG_HOME=.cache/xdg node node_modules/.bin/gatsby build",
    "predev": "bun run check:runtime && mkdir -p .cache/xdg",
    "dev": "GATSBY_TELEMETRY_DISABLED=1 XDG_CONFIG_HOME=.cache/xdg node node_modules/.bin/gatsby develop",
    "dev:local": "URL=http://localhost:8000 bun run dev",
    "check": "bun scripts/check.js",
    "format": "bun --bun node_modules/.bin/prettier --write \"src/**/*.{js,jsx,json,md}\" \"scripts/**/*.js\" \"webpack/**/*.js\" \"gatsby-*.js\" \"gatsby-config.js\" \"gatsby-node.js\" \"package.json\" \"README.md\"",
    "clean": "GATSBY_TELEMETRY_DISABLED=1 XDG_CONFIG_HOME=.cache/xdg node node_modules/.bin/gatsby clean"
  }
}
